generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerStatus {
  NEEDS_INFO
  PROCESSING
  APPROVED
  REJECTED
}

enum PaymentIntentStatus {
  PENDING
  DETECTED
  CONFIRMED
  FAILED
}

enum TreasuryWalletType {
  HOT
  COLD
}

enum UserRole {
  ADMIN
  VIEWER
}

model Merchant {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String?
  passwordHash String    @map("password_hash")
  kycStatus    KycStatus @default(PENDING) @map("kyc_status")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  paymentIntents   PaymentIntent[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  customers        Customer[]
  subscriptions    Subscription[]
  users            User[]

  @@map("merchants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Customer {
  id          String         @id @default(uuid()) @db.Uuid
  merchantId  String         @map("merchant_id") @db.Uuid
  firstName   String?        @map("first_name")
  lastName    String?        @map("last_name")
  email       String?
  phoneNumber String?        @map("phone_number")
  countryCode String?        @map("country_code")
  status      CustomerStatus @default(NEEDS_INFO)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]

  @@index([merchantId, status])
  @@map("customers")
}

model PaymentIntent {
  id         String                @id @default(uuid()) @db.Uuid
  merchantId String                @map("merchant_id") @db.Uuid
  amount     Decimal               @db.Decimal(18, 2)
  currency   String                @db.VarChar(3)
  status     PaymentIntentStatus   @default(PENDING)
  createdAt  DateTime              @default(now()) @map("created_at")
  deletedAt  DateTime?             @map("deleted_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@map("payment_intents")
}

model TreasuryAsset {
  symbol        String @id @db.VarChar(10)
  totalMinted   Decimal @default(0) @map("total_minted") @db.Decimal(36, 2)
  totalReserved Decimal @default(0) @map("total_reserved") @db.Decimal(36, 2)

  @@map("treasury_assets")
}

model TreasuryWallet {
  id          String              @id @default(uuid()) @db.Uuid
  assetCode   String              @map("asset_code") @db.VarChar(10)
  address     String
  walletType  TreasuryWalletType @default(HOT) @map("wallet_type")
  label       String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("treasury_wallets")
}

model WebhookEndpoint {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  url        String
  secret     String
  createdAt  DateTime @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  webhookEvents WebhookEvent[]

  @@index([merchantId])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id                String   @id @default(uuid()) @db.Uuid
  webhookEndpointId String   @map("webhook_endpoint_id") @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  type              String   @map("event_type")
  payload           Json
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId, createdAt])
  @@index([merchantId])
  @@map("webhook_events")
}

model ApiKey {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  keyHash    String   @map("key_hash")
  prefix     String   @default("sp_live_")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("api_keys")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @map("merchant_id") @db.Uuid
  eventType    String   @map("event_type")
  metadata     Json
  ip           String
  previousHash String?  @map("previous_hash")
  entryHash    String   @unique @map("entry_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("audit_logs")
}

enum SubscriptionInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("subscription_interval")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

model Subscription {
  id         String               @id @default(uuid()) @db.Uuid
  merchantId String               @map("merchant_id") @db.Uuid
  customerId String               @map("customer_id") @db.Uuid
  planName   String               @map("plan_name")
  amount     Decimal              @db.Decimal(18, 2)
  currency   String               @db.VarChar(3)
  interval   SubscriptionInterval
  status     SubscriptionStatus
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([customerId])
  @@map("subscriptions")
}
